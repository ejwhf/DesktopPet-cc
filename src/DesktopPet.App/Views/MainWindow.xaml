<Window x:Class="DesktopPet.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌宠"
        Width="300"
        Height="360"
        MinWidth="120"
        MinHeight="144"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Grid x:Name="WindowSurface"
          Background="Transparent">
        <!-- The final RGBA action image is assigned to this element by the asset pipeline. -->
        <Image x:Name="PetImage"
               Margin="12"
               Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality"
               Visibility="Collapsed" />

        <Border x:Name="ActionPicker"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="8"
                Padding="8"
                Background="#E6262630"
                BorderBrush="#80FFFFFF"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Foreground="White" FontWeight="SemiBold" Text="调试动作" />
                <ComboBox x:Name="ActionComboBox"
                          MinWidth="190"
                          Margin="0,5,0,0"
                          SelectionChanged="OnActionSelectionChanged"
                          SelectedIndex="0">
                    <ComboBoxItem Content="自动行为" Tag="auto" />
                    <ComboBoxItem Content="01 · 探头" Tag="peek.screen_left" />
                    <ComboBoxItem Content="02 · 下落/伸手" Tag="falling.reach" />
                    <ComboBoxItem Content="03 · 坐姿读书" Tag="sit.edge_idle" />
                    <ComboBoxItem Content="04 · 坐姿读书（变体）" Tag="sit.edge_alt" />
                    <ComboBoxItem Content="05 · 闭眼微笑" Tag="idle.blink_smile" />
                    <ComboBoxItem Content="06 · 待机" Tag="idle.neutral" />
                    <ComboBoxItem Content="07 · 待机（变体）" Tag="idle.alt" />
                    <ComboBoxItem Content="08 · 阅读" Tag="read.small" />
                    <ComboBoxItem Content="09 · 捧书阅读" Tag="read.hold" />
                    <ComboBoxItem Content="10 · 坐睡" Tag="sleep.seated" />
                    <ComboBoxItem Content="11 · 爱心" Tag="heart" />
                    <ComboBoxItem Content="12 · 阅读惊喜" Tag="read.surprised" />
                    <ComboBoxItem Content="13 · 坐睡（变体）" Tag="sleep.seated_alt" />
                    <ComboBoxItem Content="14 · 爱心（高举）" Tag="heart.raise" />
                    <ComboBoxItem Content="15 · 挥手" Tag="wave.single_a" />
                    <ComboBoxItem Content="16 · 双手欢呼" Tag="cheer.both_hands" />
                    <ComboBoxItem Content="17 · 单手挥舞" Tag="wave.single_b" />
                    <ComboBoxItem Content="18 · 趴写" Tag="write.prone" />
                    <Separator />
                    <ComboBoxItem Content="动画 · 待机循环" Tag="idle.loop" />
                    <ComboBoxItem Content="动画 · 坐姿循环" Tag="sit.loop" />
                    <ComboBoxItem Content="动画 · 阅读循环" Tag="read.loop" />
                    <ComboBoxItem Content="动画 · 睡眠循环" Tag="sleep.loop" />
                    <ComboBoxItem Content="动画 · 爱心" Tag="heart.play" />
                    <ComboBoxItem Content="动画 · 招手" Tag="wave.play" />
                    <ComboBoxItem Content="动画 · 写字循环" Tag="write.loop" />
                    <ComboBoxItem Content="动画 · 拖拽" Tag="drag.loop" />
                    <ComboBoxItem Content="动画 · 下落" Tag="fall.play" />
                </ComboBox>
            </StackPanel>
        </Border>

        <Border x:Name="RecoveryHint"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="10"
                Padding="8,4"
                Background="#C0262630"
                CornerRadius="8"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <TextBlock Foreground="White" FontSize="12" Text="已恢复控制 · Ctrl+Alt+Shift+P" />
        </Border>
    </Grid>
</Window>
